{
  "expo": {
    "name": "Librerio",
    "slug": "librerio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios/iTunesArtwork@2x.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/ios/iTunesArtwork@2x.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1714"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.librerio.myapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/play/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundColor": "#1C1714"
      },
      "package": "com.librerio.myapp"
    },
    "web": {
      "favicon": "./assets/play/playstore-icon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "owner": "jopt05",
    "extra": {
      "eas": {
        "projectId": "524c0bb7-e597-4a9f-b8d3-b76370ffdba9"
      }
    }
  }
}
